diff --git a/Examples/Monocular/mono_seq.cc b/Examples/Monocular/mono_seq.cc
new file mode 100644
index 0000000..f7696e4
--- /dev/null
+++ b/Examples/Monocular/mono_seq.cc
@@ -0,0 +1,143 @@
+// Headless monocular runner for TUM-style sequences (rgb.txt: "timestamp rgb/xxxxx.jpg", '#' comments allowed).
+// Usage: mono_seq vocab settings seq_dir out_dir [--viewer] [--fast]
+//   --fast : do not pace frames at the sequence frame rate (default: real-time pacing like mono_tum)
+// Writes into out_dir: KeyFrameTrajectory.txt, CameraTrajectory.txt, mappoints.txt, mappoints_info.txt,
+//   kf_observations.txt, maps.txt, frames.txt (per-frame state + live pose), timing.txt
+
+#include <algorithm>
+#include <chrono>
+#include <fstream>
+#include <iomanip>
+#include <iostream>
+#include <numeric>
+#include <sstream>
+#include <thread>
+#include <unistd.h>
+
+#include <opencv2/core/core.hpp>
+#include <opencv2/imgcodecs.hpp>
+#include <opencv2/imgproc.hpp>
+
+#include <System.h>
+
+using namespace std;
+
+static void LoadImages(const string &strFile, vector<string> &vFiles, vector<double> &vT)
+{
+    ifstream f(strFile.c_str());
+    string line;
+    while (getline(f, line))
+    {
+        if (line.empty() || line[0] == '#') continue;
+        stringstream ss(line);
+        double t; string name;
+        if (ss >> t >> name) { vT.push_back(t); vFiles.push_back(name); }
+    }
+}
+
+int main(int argc, char **argv)
+{
+    if (argc < 5)
+    {
+        cerr << "Usage: mono_seq vocab settings seq_dir out_dir [--viewer] [--fast]" << endl;
+        return 1;
+    }
+    bool viewer = false, fast = false;
+    for (int i = 5; i < argc; i++)
+    {
+        string a = argv[i];
+        if (a == "--viewer") viewer = true;
+        if (a == "--fast") fast = true;
+    }
+    const string seq = argv[3], out = argv[4];
+
+    vector<string> vFiles; vector<double> vT;
+    LoadImages(seq + "/rgb.txt", vFiles, vT);
+    const int n = vFiles.size();
+    if (n == 0) { cerr << "no images in " << seq << "/rgb.txt" << endl; return 1; }
+
+    auto wall0 = chrono::steady_clock::now();
+    ORB_SLAM3::System SLAM(argv[1], argv[2], ORB_SLAM3::System::MONOCULAR, viewer);
+    auto wallInit = chrono::steady_clock::now();
+    const float imageScale = SLAM.GetImageScale();
+
+    vector<double> vTrack(n, 0.0);
+    ofstream ffr((out + "/frames.txt").c_str());
+    ffr << "# idx timestamp state n_tracked_mps track_ms  live_Twc(tx ty tz qx qy qz qw; zeros if not tracking)\n";
+    ffr << "# state: -1 not ready, 0 no images, 1 not initialized, 2 OK, 3 recently lost, 4 lost\n" << fixed;
+
+    int firstOK = -1, nOK = 0, nLost = 0, nNotInit = 0, prevState = -2, nMapChanges = 0;
+    cout << "Images in the sequence: " << n << endl;
+    for (int i = 0; i < n; i++)
+    {
+        cv::Mat im = cv::imread(seq + "/" + vFiles[i], cv::IMREAD_UNCHANGED);
+        if (im.empty()) { cerr << "Failed to load " << vFiles[i] << endl; return 1; }
+        if (imageScale != 1.f)
+            cv::resize(im, im, cv::Size(im.cols * imageScale, im.rows * imageScale));
+
+        auto t1 = chrono::steady_clock::now();
+        Sophus::SE3f Tcw = SLAM.TrackMonocular(im, vT[i]);
+        auto t2 = chrono::steady_clock::now();
+        double ttrack = chrono::duration<double>(t2 - t1).count();
+        vTrack[i] = ttrack * 1e3;
+
+        int state = SLAM.GetTrackingState();
+        int nMP = 0;
+        for (auto p : SLAM.GetTrackedMapPoints()) if (p) nMP++;
+        if (SLAM.MapChanged()) { nMapChanges++; cout << "[mono_seq] frame " << i << ": big map change (loop closure / merge / GBA)" << endl; }
+        if (state != prevState)
+            cout << "[mono_seq] frame " << i << " t=" << setprecision(3) << vT[i] << ": tracking state " << prevState << " -> " << state << endl;
+        prevState = state;
+        if (state == 2) { nOK++; if (firstOK < 0) firstOK = i; }
+        else if (state == 3 || state == 4) nLost++;
+        else nNotInit++;
+
+        ffr << i << " " << setprecision(6) << vT[i] << " " << state << " " << nMP << " " << setprecision(2) << vTrack[i];
+        if (state == 2 || state == 3)
+        {
+            Sophus::SE3f Twc = Tcw.inverse();
+            Eigen::Vector3f t = Twc.translation(); Eigen::Quaternionf q = Twc.unit_quaternion();
+            ffr << setprecision(6) << " " << t(0) << " " << t(1) << " " << t(2) << " " << q.x() << " " << q.y() << " " << q.z() << " " << q.w();
+        }
+        else ffr << " 0 0 0 0 0 0 1";
+        ffr << "\n";
+
+        if (!fast)
+        {
+            double T = (i < n - 1) ? vT[i + 1] - vT[i] : (i > 0 ? vT[i] - vT[i - 1] : 0);
+            if (ttrack < T) usleep((T - ttrack) * 1e6);
+        }
+    }
+    ffr.close();
+    auto wallLoop = chrono::steady_clock::now();
+
+    SLAM.Shutdown();
+    auto wallShut = chrono::steady_clock::now();
+    SLAM.ExportMonoMap(out);
+
+    vector<double> s = vTrack; sort(s.begin(), s.end());
+    double mean = accumulate(s.begin(), s.end(), 0.0) / n;
+    auto pct = [&](double p) { return s[min(n - 1, (int)(p * (n - 1) + 0.5))]; };
+    ofstream ft((out + "/timing.txt").c_str());
+    ft << fixed << setprecision(2);
+    ft << "frames " << n << "\n";
+    ft << "pacing " << (fast ? "none (--fast)" : "real-time (sleep to sequence timestamps)") << "\n";
+    ft << "track_ms_median " << pct(0.5) << "\n";
+    ft << "track_ms_mean " << mean << "\n";
+    ft << "track_ms_p90 " << pct(0.9) << "\n";
+    ft << "track_ms_max " << s.back() << "\n";
+    ft << "track_ms_total " << accumulate(s.begin(), s.end(), 0.0) << "\n";
+    ft << "wall_s_init_vocab " << chrono::duration<double>(wallInit - wall0).count() << "\n";
+    ft << "wall_s_loop " << chrono::duration<double>(wallLoop - wallInit).count() << "\n";
+    ft << "wall_s_shutdown " << chrono::duration<double>(wallShut - wallLoop).count() << "\n";
+    ft << "wall_s_total " << chrono::duration<double>(wallShut - wall0).count() << "\n";
+    ft << "first_ok_frame " << firstOK << "\n";
+    ft << "frames_ok " << nOK << "\nframes_lost " << nLost << "\nframes_not_initialized " << nNotInit << "\n";
+    ft << "big_map_changes " << nMapChanges << "\n";
+    ft << "# per-frame track ms in frames.txt (col 5)\n";
+    ft.close();
+
+    cout << "first OK frame " << firstOK << ", OK " << nOK << ", lost " << nLost << ", not-init " << nNotInit << endl;
+    cout << "median tracking time " << pct(0.5) << " ms, mean " << mean << " ms" << endl;
+    return 0;
+}
