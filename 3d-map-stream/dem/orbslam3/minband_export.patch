diff --git a/src/System.cc b/src/System.cc
index 60d9c51..cf1da43 100644
--- a/src/System.cc
+++ b/src/System.cc
@@ -1547,3 +1547,103 @@ string System::CalculateCheckSum(string filename, int type)
 
 } //namespace ORB_SLAM
 
+
+// ---- Added for headless runs: export biggest map (trajectory, keyframes, map points, observations) ----
+namespace ORB_SLAM3 {
+void System::ExportMonoMap(const string &dir)
+{
+    vector<Map*> vpMaps = mpAtlas->GetAllMaps();
+    Map* pBig = nullptr; size_t nBig = 0;
+    ofstream fs((dir + "/maps.txt").c_str());
+    fs << "# map_id n_keyframes n_mappoints\n";
+    for(Map* pMap : vpMaps)
+    {
+        fs << pMap->GetId() << " " << pMap->GetAllKeyFrames().size() << " " << pMap->GetAllMapPoints().size() << "\n";
+        if(pMap->GetAllKeyFrames().size() > nBig) { nBig = pMap->GetAllKeyFrames().size(); pBig = pMap; }
+    }
+    fs.close();
+    if(!pBig) { cerr << "ExportMonoMap: no map" << endl; return; }
+    cout << "Exporting map " << pBig->GetId() << " (" << nBig << " KFs) of " << vpMaps.size() << " maps" << endl;
+
+    vector<KeyFrame*> vpKFs = pBig->GetAllKeyFrames();
+    sort(vpKFs.begin(), vpKFs.end(), KeyFrame::lId);
+
+    // Keyframe trajectory, TUM, camera-to-world, map world frame
+    ofstream fk((dir + "/KeyFrameTrajectory.txt").c_str());
+    fk << fixed;
+    for(KeyFrame* pKF : vpKFs)
+    {
+        if(pKF->isBad()) continue;
+        Sophus::SE3f Twc = pKF->GetPoseInverse();
+        Eigen::Quaternionf q = Twc.unit_quaternion();
+        Eigen::Vector3f t = Twc.translation();
+        fk << setprecision(6) << pKF->mTimeStamp << " " << setprecision(9) << t(0) << " " << t(1) << " " << t(2)
+           << " " << q.x() << " " << q.y() << " " << q.z() << " " << q.w() << "\n";
+    }
+    fk.close();
+
+    // All-frame trajectory (frames tracked w.r.t. a keyframe of the exported map), TUM, same frame
+    ofstream ff((dir + "/CameraTrajectory.txt").c_str());
+    ff << fixed;
+    auto lRit = mpTracker->mlpReferences.begin();
+    auto lT = mpTracker->mlFrameTimes.begin();
+    auto lbL = mpTracker->mlbLost.begin();
+    for(auto lit = mpTracker->mlRelativeFramePoses.begin(); lit != mpTracker->mlRelativeFramePoses.end(); lit++, lRit++, lT++, lbL++)
+    {
+        if(*lbL) continue;
+        KeyFrame* pKF = *lRit;
+        if(!pKF) continue;
+        Sophus::SE3f Trw;
+        while(pKF && pKF->isBad()) { Trw = Trw * pKF->mTcp; pKF = pKF->GetParent(); }
+        if(!pKF || pKF->GetMap() != pBig) continue;
+        Trw = Trw * pKF->GetPose();
+        Sophus::SE3f Twc = ((*lit) * Trw).inverse();
+        Eigen::Quaternionf q = Twc.unit_quaternion();
+        Eigen::Vector3f t = Twc.translation();
+        ff << setprecision(6) << *lT << " " << setprecision(9) << t(0) << " " << t(1) << " " << t(2)
+           << " " << q.x() << " " << q.y() << " " << q.z() << " " << q.w() << "\n";
+    }
+    ff.close();
+
+    // Map points: "x y z" (world), row index used by kf_observations.txt
+    vector<MapPoint*> vpMPs = pBig->GetAllMapPoints();
+    std::map<MapPoint*, long> row;
+    ofstream fm((dir + "/mappoints.txt").c_str());
+    ofstream fmi((dir + "/mappoints_info.txt").c_str());
+    fmi << "# row mp_id n_obs found_ratio min_dist max_dist ref_kf_id\n";
+    fm << fixed << setprecision(6);
+    long r = 0;
+    for(MapPoint* pMP : vpMPs)
+    {
+        if(!pMP || pMP->isBad()) continue;
+        Eigen::Vector3f p = pMP->GetWorldPos();
+        fm << p(0) << " " << p(1) << " " << p(2) << "\n";
+        KeyFrame* pRef = pMP->GetReferenceKeyFrame();
+        fmi << r << " " << pMP->mnId << " " << pMP->Observations() << " " << setprecision(3) << pMP->GetFoundRatio()
+            << " " << pMP->GetMinDistanceInvariance() << " " << pMP->GetMaxDistanceInvariance() << " " << (pRef ? (long)pRef->mnId : -1L) << setprecision(6) << "\n";
+        row[pMP] = r++;
+    }
+    fm.close(); fmi.close();
+
+    // Observations: "kf_id timestamp mp_row u v" (undistorted pixel coords)
+    ofstream fo((dir + "/kf_observations.txt").c_str());
+    fo << "# kf_id timestamp mappoint_row u v\n" << fixed;
+    for(KeyFrame* pKF : vpKFs)
+    {
+        if(pKF->isBad()) continue;
+        vector<MapPoint*> vm = pKF->GetMapPointMatches();
+        for(size_t i = 0; i < vm.size(); i++)
+        {
+            MapPoint* pMP = vm[i];
+            if(!pMP || pMP->isBad()) continue;
+            auto it = row.find(pMP);
+            if(it == row.end()) continue;
+            const cv::KeyPoint &kp = (pKF->NLeft == -1) ? pKF->mvKeysUn[i] : pKF->mvKeys[i];
+            fo << pKF->mnId << " " << setprecision(6) << pKF->mTimeStamp << " " << it->second << " "
+               << setprecision(2) << kp.pt.x << " " << kp.pt.y << "\n";
+        }
+    }
+    fo.close();
+    cout << "Exported " << r << " map points" << endl;
+}
+}
