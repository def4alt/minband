diff --git a/run_seq.sh b/run_seq.sh
new file mode 100755
index 0000000..a86a607
--- /dev/null
+++ b/run_seq.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+# run_seq.sh <seq_dir> <out_dir> <settings.yaml> [extra mono_seq flags, e.g. --fast]
+set -euo pipefail
+ORB=$(cd "$(dirname "$0")" && pwd)
+SEQ=$1; OUT=$2; CFG=$3; shift 3
+mkdir -p "$OUT"
+cp "$CFG" "$OUT/settings.yaml"
+t0=$(date +%s)
+"$ORB/Examples/Monocular/mono_seq" "$ORB/Vocabulary/ORBvoc.txt" "$OUT/settings.yaml" "$SEQ" "$OUT" "$@" > "$OUT/run.log" 2>&1
+rc=$?
+echo "wall_s_process $(( $(date +%s) - t0 ))" >> "$OUT/timing.txt"
+exit $rc
